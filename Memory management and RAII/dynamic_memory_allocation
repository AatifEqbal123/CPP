#include <iostream>
#include <string>
#include <typeinfo>
#include <vector>

using namespace std;

void shiftAndChange(int* &pX, int* pY, int &num) {
    pX = pX + 2;   
    *pX = *pX - 5; 
    pY = pX - 1;   
    *pY = *pY * 2; 
    num = num + *pY; 
}

int main() {
    // pointers
    int a = 2;
    int* ptr = &a;
    cout<<"memory adress "<<ptr<<endl;
    cout<<"actual value "<<*ptr<<endl;
    
    // paractice pro
    int data[] = {10, 20, 30, 40};
    int total = 5;

    int* ptr1 = &data[0]; 
    int* ptr2 = &data[1]; 

    shiftAndChange(ptr1, ptr2, total);

    std::cout << "data[1]: " << data[1] << "\n";
    std::cout << "data[2]: " << data[2] << "\n";
    std::cout << "total: " << total << "\n";
    std::cout << "*ptr1: " << *ptr1 << "\n";
    std::cout << "*ptr2: " << *ptr2 << "\n";
    
    // answer 40,25,45,25,40
    
}